{
  "name": "bullbrief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:privacy": "node scripts/test-privacy-guards.cjs",
    "test:kyp": "node scripts/test-kyp-review.cjs",
    "test:kyp-simulation": "node scripts/test-kyp-simulation.cjs",
    "test:crm": "node scripts/test-crm.cjs",
    "test:crm:db": "python3 scripts/test-crm-database.py",
    "test:crm-import": "node scripts/test-crm-import.cjs",
    "test:crm-import:db": "CRM_QA_SQL=tests/crm-import-database.sql python3 scripts/test-crm-database.py",
    "test:crm-practice": "node scripts/test-crm-practice.cjs",
    "test:crm-practice:db": "CRM_QA_SQL=tests/crm-practice-database.sql python3 scripts/test-crm-database.py",
    "test:crm-schedule": "node scripts/test-crm-schedule.cjs",
    "test:crm-schedule:db": "CRM_QA_SQL=tests/crm-schedule-database.sql python3 scripts/test-crm-database.py",
    "test:microsoft": "node scripts/test-microsoft.cjs",
    "test:microsoft:db": "CRM_QA_SQL=tests/microsoft-database.sql python3 scripts/test-crm-database.py",
    "test:crm-invitations": "node scripts/test-crm-invitations.cjs",
    "test:crm-invitations:db": "CRM_QA_SQL=tests/crm-invitations-database.sql python3 scripts/test-crm-database.py"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.2",
    "@napi-rs/canvas": "^0.1.80",
