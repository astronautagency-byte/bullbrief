# Database
DATABASE_URL=

# Auth (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Market Data
MARKETSTACK_API_KEY=
MARKETAUX_API_TOKEN=
MEDIASTACK_API_KEY=

# Podcasts
PODCAST_API_KEY=
PODCAST_API_USER_ID=

# Cron
CRON_SECRET=
RAPIDAPI_MORNINGSTAR_KEY=

# Morningstar Direct Web Services (licensed account required)
MORNINGSTAR_DWS_BASE_URL=https://www.us-api.morningstar.com/direct-web-services
MORNINGSTAR_DWS_AUTH_URL=
MORNINGSTAR_DWS_USERNAME=
MORNINGSTAR_DWS_PASSWORD=
MORNINGSTAR_DWS_CLIENT_ID=
MORNINGSTAR_DWS_CLIENT_SECRET=
# Optional for a short-lived local connection test. Prefer OAuth credentials in production.
MORNINGSTAR_DWS_ACCESS_TOKEN=
# View IDs must match the investment-detail views entitled to your Morningstar account.
MORNINGSTAR_DWS_EQUITY_VIEW=
MORNINGSTAR_DWS_MANAGED_VIEW=

# Vendor-review gate. Leave false until authorized reviewers approve the exact AI use.
# Having a Groq API key alone never enables external AI calls.
BULLBRIEF_EXTERNAL_AI_ENABLED=false
